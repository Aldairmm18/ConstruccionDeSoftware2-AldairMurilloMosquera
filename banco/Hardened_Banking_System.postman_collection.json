            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceAccountNumber\": \"{{accountNumber1}}\",\n  \"targetAccountNumber\": \"{{accountNumber2}}\",\n  \"amount\": 100000\n}"
            },
            "url": {

        {
          "name": "03 - Login Admin (guarda token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token guardado correctamente');",
                  "} else {",
                  "    console.error('No se encontró token en la respuesta');",
                  "}",
                  "pm.test('Login exitoso - status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Token presente en respuesta', function () {",
                  "    pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_banco\",\n  \"password\": \"Admin@2024!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica al admin y guarda el JWT en {{token}} automáticamente."
          }
        },

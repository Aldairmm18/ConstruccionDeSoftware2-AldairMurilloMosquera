{
  "info": {
    "name": "Sistema Bancario Blindado",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Crear Cuenta",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "http://localhost:8080/api/cuentas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountNumber\": \"1234567890\",\n  \"accountType\": \"SAVINGS\",\n  \"currentBalance\": 1000000,\n  \"clientId\": 1\n}"
        }
      }
    },
    {
      "name": "2. Crear Transferencia",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "http://localhost:8080/api/transferencias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numeroCuentaOrigen\": \"1234567890\",\n  \"numeroCuentaDestino\": \"0987654321\",\n  \"monto\": 150000.50\n}"
        }
      }
    },
    {
      "name": "3. Aprobar Transferencia",
      "request": {
        "method": "POST",
        "url": "http://localhost:8080/api/transferencias/1/aprobar?usuarioId=99"
      }
    },
    {
      "name": "4. Listar Transferencias",
      "request": {
        "method": "GET",
        "url": "http://localhost:8080/api/transferencias"
      }
    },
    {
      "name": "5. Crear Depósito",
      "request": {
        "method": "POST",
        "url": "http://localhost:8080/api/transacciones/deposito?accountNumber=1234567890&amount=500000"
      }
    },
    {
      "name": "6. Solicitar Préstamo",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "http://localhost:8080/api/prestamos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client\": {\"id\": 1},\n  \"requestedAmount\": 10000000,\n  \"interestRate\": 12.5,\n  \"termMonths\": 36,\n  \"disbursementTargetAccount\": {\"accountNumber\": \"1234567890\"}\n}"
        }
      }
    },
    {
      "name": "7. Aprobar Préstamo",
      "request": {
        "method": "POST",
        "url": "http://localhost:8080/api/prestamos/1/aprobar?usuarioId=99"
      }
    },
    {
      "name": "8. Desembolsar Préstamo",
      "request": {
        "method": "POST",
        "url": "http://localhost:8080/api/prestamos/1/desembolsar"
      }
    },
    {
      "name": "TEST: Monto Negativo (debe fallar)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "http://localhost:8080/api/transferencias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numeroCuentaOrigen\": \"1234567890\",\n  \"numeroCuentaDestino\": \"0987654321\",\n  \"monto\": -1000\n}"
        }
      }
    },
    {
      "name": "TEST: Saldo Insuficiente (debe fallar)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "http://localhost:8080/api/transferencias",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numeroCuentaOrigen\": \"1234567890\",\n  \"numeroCuentaDestino\": \"0987654321\",\n  \"monto\": 99999999\n}"
        }
      }
    }
  ]
}
